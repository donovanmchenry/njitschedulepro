# Optional public API URL used directly by the browser.
# Leave unset in local development to use the Next.js /api proxy.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Server-side API target used by the Next.js proxy.
API_PROXY_TARGET=http://localhost:8000

# AI schedule parsing (server only; never expose this as NEXT_PUBLIC_*)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Shared rate limiting. Leave REDIS_URL unset for the process-local development fallback.
# When REDIS_URL is configured but unavailable, metered endpoints fail closed.
# REDIS_URL=redis://localhost:6379/0
AI_HOURLY_LIMIT_PER_USER=3
AI_DAILY_LIMIT_PER_USER=5
# Rolling 30-day allowance per hashed client identity.
AI_TOTAL_LIMIT_PER_USER=15
# Deployment-wide ceiling; raise or reset deliberately when replenishing the budget.
AI_GLOBAL_TOTAL_LIMIT=7000
SOLVE_RATE_LIMIT_PER_MINUTE=30
SOLVE_CONCURRENCY=1
RATE_LIMIT_KEY_PREFIX=schedule-pro

# Python environment
PYTHONUNBUFFERED=1

# Database (optional - for future use)
# DATABASE_URL=sqlite:///./njit_schedule_pro.db
